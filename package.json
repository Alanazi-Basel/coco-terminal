{
  "name": "coco-terminal",
  "desktopName": "app.coco.terminal",
  "version": "1.0.3",
  "description": "A modern workspace terminal for macOS, Windows, and Linux.",
  "main": "src/main/main.js",
  "author": "Coco",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "rebuild": "electron-builder install-app-deps",
    "postinstall": "electron-builder install-app-deps",
    "dist": "electron-builder --mac",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win --x64",
    "dist:linux": "electron-builder --linux --x64",
    "test": "node --test test/*.test.cjs",
    "dist:beta": "node scripts/build-beta-mac.cjs",
    "version:patch": "npm version patch --no-git-tag-version",
    "version:minor": "npm version minor --no-git-tag-version",
    "version:major": "npm version major --no-git-tag-version",
    "app": "electron ."
  },
  "build": {
    "appId": "app.coco.terminal",
    "productName": "coco",
    "asar": true,
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "publish": [
      {
        "provider": "generic",
        "url": "https://tarout.sa/api/storage/gateway/cmrsa7oqw00je01pjsvkc2wk7/stable"
      }
    ],
    "mac": {
      "icon": "assets/icon-source.png",
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg",
        "zip"
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "assets/entitlements.mac.plist",
      "entitlementsInherit": "assets/entitlements.mac.plist",
      "notarize": true
    },
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false
    },
    "linux": {
      "icon": "assets/icon-source.png",
      "category": "Development",
      "syncDesktopName": true,
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "!assets/marketing/**"
    ],
    "dmg": {
      "sign": true
    }
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-search": "^0.15.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/xterm": "^5.5.0",
    "electron-updater": "^6.8.9",
    "lucide-static": "^1.22.0",
    "node-pty": "^1.0.0",
    "ssh2": "^1.17.0"
  },
  "devDependencies": {
    "electron": "^43.1.1",
    "electron-builder": "^26.15.3"
  }
}
